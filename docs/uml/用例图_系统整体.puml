@startuml
left to right direction
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 80      ' 增大同级节点水平间距
skinparam ranksep 60      ' 增大层与层之间的垂直间距
skinparam padding 20      ' 整体内边距

title 系统整体用例图

actor "玩家" as Player
actor "房主" as Host
actor "访客" as Guest

rectangle "墙间跑酷系统" {
    usecase "单人离线游玩" as UC1
    usecase "公共服务器联机" as UC2
    usecase "创建房间" as UC3
    usecase "加入房间" as UC4
    usecase "跳跃换墙" as UC5
    usecase "躲避障碍物" as UC6
    usecase "收集道具" as UC7
    usecase "玩家碰撞互动" as UC8
    usecase "自定义角色外观" as UC9
    usecase "查看排行榜" as UC10
    usecase "配置游戏设置" as UC11
    usecase "观战模式" as UC12

    UC2 ..> UC5 : <<include>>
    UC3 ..> UC5 : <<include>>
    UC4 ..> UC5 : <<include>>
    UC1 ..> UC6 : <<include>>
    UC2 ..> UC6 : <<include>>
    UC3 ..> UC6 : <<include>>
    UC4 ..> UC6 : <<include>>
    UC12 ..> UC2 : <<extend>>
}

Player --> UC1
Player --> UC2
Player --> UC5
Player --> UC6
Player --> UC7
Player --> UC8
Player --> UC9
Player --> UC10
Player --> UC11
Host --> UC3
Guest --> UC4
Guest --> UC5
Guest --> UC6

@enduml
